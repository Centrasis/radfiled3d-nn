#version 450
// Ray-march the predicted radiation field.
//
// The volume this samples is the SAME memory inference wrote into: Vulkan allocated it, exported a
// handle, the CUDA session imported that handle and bound it as the model's `flux` output. Nothing
// is copied between the network and this shader — the buffer below and the network's output tensor
// are one allocation, which is the property the whole application exists to demonstrate.

layout(local_size_x = 8, local_size_y = 8) in;

/// flux per voxel, x fastest, then y, then z — RadFiled3D's own voxel order.
layout(std430, binding = 0) readonly buffer Volume { float flux[]; };
/// 0xAABBGGRR per pixel, ready to write out as an image.
layout(std430, binding = 1) writeonly buffer Image { uint pixel[]; };
/// The phantom's occupancy in ITS OWN frame, the same canonical grid the physics probe marches.
/// Drawn so the sweep can be read: without it a moving patient is only an inference about a
/// changing scatter cloud, and the point is to see whether the cloud follows the body.
layout(std430, binding = 2) readonly buffer Patient { float occupancy[]; };

layout(push_constant) uniform Push {
    uvec3 voxels;      // grid resolution
    uint  width;
    uint  height;
    float yaw;         // camera orbit
    float pitch;
    float distance;
    // The volume's own range. Flux spans decades, so the window is applied in LOG space —
    // the same reason the packages normalise their outputs logarithmically. Windowing on the
    // actual data rather than a fixed exposure is what makes the structure visible instead of
    // a flat wash.
    float lo;
    float hi;
    // Patient frame: the phantom grid's resolution (0 = none to draw) and where its centre sits,
    // in the same field units the model uses — isocentre at 0, box edge at ±0.5.
    uint  patient_grid;
    vec3  patient_centre;
} push;

/// Occupancy at a point given in UNIT-CUBE coordinates, 0 outside the phantom's own box.
float sample_patient(vec3 p) {
    if (push.patient_grid == 0u) return 0.0;
    vec3 q = (p - vec3(0.5) - push.patient_centre) + vec3(0.5);   // unit cube -> field -> patient
    if (any(lessThan(q, vec3(0.0))) || any(greaterThanEqual(q, vec3(1.0)))) return 0.0;
    ivec3 v = ivec3(q * float(push.patient_grid));
    v = clamp(v, ivec3(0), ivec3(int(push.patient_grid) - 1));
    return occupancy[uint(v.x) + push.patient_grid * (uint(v.y) + push.patient_grid * uint(v.z))];
}

float sample_flux(ivec3 v) {
    v = clamp(v, ivec3(0), ivec3(push.voxels) - 1);
    return flux[uint(v.x) + push.voxels.x * (uint(v.y) + push.voxels.y * uint(v.z))];
}

/// Trilinear, so the marched image shows the field rather than the sampling grid.
float sample_flux(vec3 p) {
    vec3 g = p * vec3(push.voxels) - 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    float c00 = mix(sample_flux(b + ivec3(0,0,0)), sample_flux(b + ivec3(1,0,0)), f.x);
    float c10 = mix(sample_flux(b + ivec3(0,1,0)), sample_flux(b + ivec3(1,1,0)), f.x);
    float c01 = mix(sample_flux(b + ivec3(0,0,1)), sample_flux(b + ivec3(1,0,1)), f.x);
    float c11 = mix(sample_flux(b + ivec3(0,1,1)), sample_flux(b + ivec3(1,1,1)), f.x);
    return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

/// Slab test against the unit cube the field occupies.
bool intersect_unit_cube(vec3 origin, vec3 dir, out float t0, out float t1) {
    vec3 inv = 1.0 / dir;
    vec3 a = (vec3(0.0) - origin) * inv;
    vec3 b = (vec3(1.0) - origin) * inv;
    vec3 lo = min(a, b), hi = max(a, b);
    t0 = max(max(lo.x, lo.y), lo.z);
    t1 = min(min(hi.x, hi.y), hi.z);
    return t1 > max(t0, 0.0);
}

/// Dose-style ramp: blue (cold) -> green -> red -> white (hot).
vec3 palette(float x) {
    x = clamp(x, 0.0, 1.0);
    vec3 c = mix(vec3(0.0, 0.05, 0.35), vec3(0.0, 0.75, 0.35), smoothstep(0.0, 0.4, x));
    c = mix(c, vec3(0.95, 0.75, 0.0), smoothstep(0.35, 0.7, x));
    c = mix(c, vec3(1.0, 0.25, 0.1), smoothstep(0.65, 0.9, x));
    return mix(c, vec3(1.0), smoothstep(0.9, 1.0, x));
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= push.width || px.y >= push.height) return;

    // Camera orbits the cube's centre and looks at it.
    vec3 forward = -vec3(cos(push.pitch) * sin(push.yaw), sin(push.pitch), cos(push.pitch) * cos(push.yaw));
    vec3 eye = vec3(0.5) - forward * push.distance;
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);

    vec2 ndc = (vec2(px) + 0.5) / vec2(push.width, push.height) * 2.0 - 1.0;
    ndc.x *= float(push.width) / float(push.height);
    vec3 dir = normalize(forward + right * ndc.x * 0.55 - up * ndc.y * 0.55);

    vec3 colour = vec3(0.02, 0.02, 0.03);   // background
    float t0, t1;
    if (intersect_unit_cube(eye, dir, t0, t1)) {
        // Emission-absorption integration, front to back, with early-out once opaque.
        const int kSteps = 256;
        float dt = (t1 - max(t0, 0.0)) / float(kSteps);
        float t = max(t0, 0.0) + dt * 0.5;
        vec3 accum = vec3(0.0);
        float transmittance = 1.0;
        for (int i = 0; i < kSteps; ++i, t += dt) {
            vec3 p = eye + dir * t;
            float raw = max(sample_flux(p), 0.0);
            float v = clamp((log(raw + 1e-30) - push.lo) / max(push.hi - push.lo, 1e-6), 0.0, 1.0);
            float alpha = 1.0 - exp(-v * 6.0 * dt);
            accum += transmittance * alpha * palette(v);
            transmittance *= 1.0 - alpha;

            // The phantom as a faint cool haze over the field. Deliberately weak and untinted by
            // the dose ramp, so it reads as geometry and can never be mistaken for predicted flux.
            float body = sample_patient(p);
            if (body > 0.5) {
                float shell = 1.0 - exp(-0.45 * dt);
                accum += transmittance * shell * vec3(0.55, 0.85, 1.0);
                transmittance *= 1.0 - shell;
            }
            if (transmittance < 0.003) break;
        }
        colour = accum + colour * transmittance;
    }

    colour = pow(clamp(colour, 0.0, 1.0), vec3(1.0 / 2.2));   // to sRGB
    uvec3 q = uvec3(colour * 255.0 + 0.5);
    pixel[px.y * push.width + px.x] = 0xFF000000u | (q.b << 16) | (q.g << 8) | q.r;
}
